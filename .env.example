# --- Desarrollo: SQLite ---
DATABASE_URL="file:./dev.db"

# --- Produccion: PostgreSQL / Supabase ---
# Antes de usar esto corre:  npm run db:postgres
# (cambia el provider en prisma/schema.prisma; no hay cambios en el codigo de la app)
#
# Pooler de Supabase, para la app en Vercel o Railway:
# DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexion directa, solo para migraciones (prisma migrate / db push):
# DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_ANIO_ACTIVO="2026"

# ==========================================================================
# FASE 2 - ingesta desde Gmail
# Estas van en .env.local (no se versiona). Ver el README, seccion Google Cloud.
# ==========================================================================

# Cliente OAuth tipo aplicacion web de Google Cloud, con el redirect
# http://localhost:3000/api/auth/callback/google y el scope gmail.readonly.
GOOGLE_CLIENT_ID="123456789012-ejemplo.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-ejemplo"

# Extraccion de recibos con claude-sonnet-4-6.
ANTHROPIC_API_KEY="sk-ant-api03-ejemplo"

# Firma la sesion JWT de Auth.js.  Generar con:  npx auth secret
AUTH_SECRET="base64-de-32-bytes-aleatorios"
# En produccion, el dominio real sin barra final.
AUTH_URL="http://localhost:3000"
# Correos autorizados a entrar, separados por coma.
ALLOWED_EMAILS="finanzas@japybrand.cl"

# Cifra el refresh token de Google en la tabla CuentaGoogle (AES-256-GCM).
# 32 bytes en hex.  Generar con:  openssl rand -hex 32
# Si cambia, hay que volver a autorizar el acceso a Gmail.
ENCRYPTION_KEY="64-caracteres-hexadecimales"

# Protege /api/ingesta/gmail.  Vercel Cron lo manda como Authorization: Bearer.
# Generar con:  openssl rand -base64 32
CRON_SECRET="base64-de-32-bytes-aleatorios"
