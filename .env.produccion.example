# Credenciales de la base de produccion en Supabase.
#
# COPIA ESTE ARCHIVO A .env.produccion Y PON TU CLAVE.
# .env.produccion esta en .gitignore y no se versiona nunca.
#
# POR QUE UN ARCHIVO APARTE Y NO .env.local
# Los scripts cargan `--env-file=.env.local --env-file=.env`, y en Node el ULTIMO
# archivo gana. Con DATABASE_URL en .env.local y el `file:./dev.db` todavia en .env,
# los scripts habrian seguido escribiendo en SQLite mientras la aplicacion apuntaba
# a Supabase, sin ningun error visible. Los comandos de migracion cargan este
# archivo de ultimo, asi que gana sin ambiguedad y el entorno local no se toca.
#
# SI LA CLAVE TIENE CARACTERES ESPECIALES HAY QUE CODIFICARLA
# Todo lo que no sea letra, numero, - . _ ~ rompe la URL. Los que mas aparecen:
#   @ -> %40    : -> %3A    / -> %2F    ? -> %3F    # -> %23
#   & -> %26    % -> %25    + -> %2B    espacio -> %20
# Para no hacerlo a mano, en la consola del navegador o en `node`:
#   encodeURIComponent('tu clave')
# y pega el resultado. No la escribas en la terminal como argumento de un comando:
# queda en el historial del shell.

# Pooler en modo transaccion, puerto 6543. Lo usa la aplicacion.
DATABASE_URL="postgresql://postgres.gyzpybiqokcznekxyrsc:TU-CLAVE-CODIFICADA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler en modo sesion, puerto 5432. Solo para prisma db push y migrate.
DIRECT_URL="postgresql://postgres.gyzpybiqokcznekxyrsc:TU-CLAVE-CODIFICADA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
